# Normalise line endings in the repo; each OS gets what its tools expect.
* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.command text eol=lf
# binaries: never touch
*.mp3 binary
*.wav binary
*.mp4 binary
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.onnx binary
*.zip binary
*.pdf binary
